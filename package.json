{
  "name": "@oursky/eslint-plugin",
  "version": "18.0.0",
  "main": "dist/index.cjs",
  "repository": "git@github.com:oursky/eslint-oursky.git",
  "author": "<louischan@oursky.com>",
  "license": "Apache-2.0",
  "scripts": {
    "build": "rollup --config",
    "prepublishOnly": "npm run format && npm run test",
    "test": "./scripts/test.sh",
    "format": "prettier --write --list-different 'src/**/*.{cjs,mjs,js,jsx,ts,tsx}'"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@eslint/compat": "^2.1.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-tsdoc": "^0.5.2",
    "typescript-eslint": "^8.65.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "prettier": "^3.8.1",
    "rollup": "^4.60.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "eslint": "^9.39.4 || ^10.8.0"
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react-native": {
      "eslint": "$eslint"
    }
  }
}
